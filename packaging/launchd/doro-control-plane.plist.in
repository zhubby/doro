<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@DORO_CONTROL_PLANE_LAUNCHD_LABEL@</string>

    <key>UserName</key>
    <string>@DORO_CONTROL_PLANE_USER@</string>
    <key>GroupName</key>
    <string>@DORO_CONTROL_PLANE_GROUP@</string>

    <key>ProgramArguments</key>
    <array>
        <string>@DORO_BIN@</string>
        <string>control-plane</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@DORO_CONTROL_PLANE_STATE_DIR@</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@DORO_CONTROL_PLANE_STATE_DIR@</string>
        <key>RUST_LOG</key>
        <string>@DORO_CONTROL_PLANE_RUST_LOG@</string>
        <key>DORO_CONTROL_PLANE_CONSOLE_BIND</key>
        <string>@DORO_CONTROL_PLANE_CONSOLE_BIND@</string>
        <key>DORO_CONTROL_PLANE_AGENT_BIND</key>
        <string>@DORO_CONTROL_PLANE_AGENT_BIND@</string>
        <key>DORO_CONTROL_PLANE_STORE_BACKEND</key>
        <string>@DORO_CONTROL_PLANE_STORE_BACKEND@</string>
        <key>DORO_CONTROL_PLANE_DATABASE_URL</key>
        <string>@DORO_CONTROL_PLANE_DATABASE_URL@</string>
        <key>DORO_CONTROL_PLANE_STORE_MAX_CONNECTIONS</key>
        <string>@DORO_CONTROL_PLANE_STORE_MAX_CONNECTIONS@</string>
        <key>DORO_CONTROL_PLANE_STORE_MIN_CONNECTIONS</key>
        <string>@DORO_CONTROL_PLANE_STORE_MIN_CONNECTIONS@</string>
        <key>DORO_CONTROL_PLANE_STORE_CONNECT_TIMEOUT_SECONDS</key>
        <string>@DORO_CONTROL_PLANE_STORE_CONNECT_TIMEOUT_SECONDS@</string>
        <key>DORO_CONTROL_PLANE_STORE_IDLE_TIMEOUT_SECONDS</key>
        <string>@DORO_CONTROL_PLANE_STORE_IDLE_TIMEOUT_SECONDS@</string>
        <key>DORO_CONTROL_PLANE_APPROVAL_POLICY</key>
        <string>@DORO_CONTROL_PLANE_APPROVAL_POLICY@</string>
        <key>DORO_CONTROL_PLANE_REQUIRE_TLS</key>
        <string>@DORO_CONTROL_PLANE_REQUIRE_TLS@</string>
        <key>DORO_CONTROL_PLANE_AI_PROVIDER</key>
        <string>@DORO_CONTROL_PLANE_AI_PROVIDER@</string>
        <key>DORO_CONTROL_PLANE_OPENAI_API_KEY_ENV</key>
        <string>@DORO_CONTROL_PLANE_OPENAI_API_KEY_ENV@</string>
        <key>DORO_CONTROL_PLANE_OPENAI_BASE_URL</key>
        <string>@DORO_CONTROL_PLANE_OPENAI_BASE_URL@</string>
        <key>DORO_CONTROL_PLANE_OPENAI_DEFAULT_CHAT_MODEL</key>
        <string>@DORO_CONTROL_PLANE_OPENAI_DEFAULT_CHAT_MODEL@</string>
        <key>DORO_CONTROL_PLANE_OPENAI_DEFAULT_RESPONSE_MODEL</key>
        <string>@DORO_CONTROL_PLANE_OPENAI_DEFAULT_RESPONSE_MODEL@</string>
        <key>DORO_CONTROL_PLANE_OPENAI_TIMEOUT_SECONDS</key>
        <string>@DORO_CONTROL_PLANE_OPENAI_TIMEOUT_SECONDS@</string>
        <key>DORO_CONTROL_PLANE_AI_AGENT_MAX_TURNS</key>
        <string>@DORO_CONTROL_PLANE_AI_AGENT_MAX_TURNS@</string>
        <key>DORO_CONTROL_PLANE_AI_AGENT_MAX_TOOL_CALLS</key>
        <string>@DORO_CONTROL_PLANE_AI_AGENT_MAX_TOOL_CALLS@</string>
        <key>DORO_CONTROL_PLANE_AI_AGENT_TOOL_TIMEOUT_SECONDS</key>
        <string>@DORO_CONTROL_PLANE_AI_AGENT_TOOL_TIMEOUT_SECONDS@</string>
        <key>DORO_CONTROL_PLANE_AI_AGENT_SHELL_TIMEOUT_SECONDS</key>
        <string>@DORO_CONTROL_PLANE_AI_AGENT_SHELL_TIMEOUT_SECONDS@</string>
        <key>DORO_CONTROL_PLANE_AI_AGENT_APPROVAL_TIMEOUT_SECONDS</key>
        <string>@DORO_CONTROL_PLANE_AI_AGENT_APPROVAL_TIMEOUT_SECONDS@</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>@DORO_CONTROL_PLANE_LOG_DIR@/control-plane.out.log</string>
    <key>StandardErrorPath</key>
    <string>@DORO_CONTROL_PLANE_LOG_DIR@/control-plane.err.log</string>

    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
    </dict>
</dict>
</plist>
