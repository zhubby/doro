[Unit]
Description=Doro Control Plane
Documentation=https://github.com/zhubby/doro
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=@DORO_CONTROL_PLANE_USER@
Group=@DORO_CONTROL_PLANE_GROUP@
Environment=HOME=@DORO_CONTROL_PLANE_STATE_DIR@
Environment=RUST_LOG=@DORO_CONTROL_PLANE_RUST_LOG@
Environment=DORO_CONTROL_PLANE_CONSOLE_BIND=@DORO_CONTROL_PLANE_CONSOLE_BIND@
Environment=DORO_CONTROL_PLANE_AGENT_BIND=@DORO_CONTROL_PLANE_AGENT_BIND@
Environment=DORO_CONTROL_PLANE_STORE_BACKEND=@DORO_CONTROL_PLANE_STORE_BACKEND@
Environment=DORO_CONTROL_PLANE_DATABASE_URL=@DORO_CONTROL_PLANE_DATABASE_URL@
Environment=DORO_CONTROL_PLANE_STORE_MAX_CONNECTIONS=@DORO_CONTROL_PLANE_STORE_MAX_CONNECTIONS@
Environment=DORO_CONTROL_PLANE_STORE_MIN_CONNECTIONS=@DORO_CONTROL_PLANE_STORE_MIN_CONNECTIONS@
Environment=DORO_CONTROL_PLANE_STORE_CONNECT_TIMEOUT_SECONDS=@DORO_CONTROL_PLANE_STORE_CONNECT_TIMEOUT_SECONDS@
Environment=DORO_CONTROL_PLANE_STORE_IDLE_TIMEOUT_SECONDS=@DORO_CONTROL_PLANE_STORE_IDLE_TIMEOUT_SECONDS@
Environment=DORO_CONTROL_PLANE_APPROVAL_POLICY=@DORO_CONTROL_PLANE_APPROVAL_POLICY@
Environment=DORO_CONTROL_PLANE_REQUIRE_TLS=@DORO_CONTROL_PLANE_REQUIRE_TLS@
Environment=DORO_CONTROL_PLANE_AI_PROVIDER=@DORO_CONTROL_PLANE_AI_PROVIDER@
Environment=DORO_CONTROL_PLANE_OPENAI_API_KEY_ENV=@DORO_CONTROL_PLANE_OPENAI_API_KEY_ENV@
Environment=DORO_CONTROL_PLANE_OPENAI_BASE_URL=@DORO_CONTROL_PLANE_OPENAI_BASE_URL@
Environment=DORO_CONTROL_PLANE_OPENAI_DEFAULT_CHAT_MODEL=@DORO_CONTROL_PLANE_OPENAI_DEFAULT_CHAT_MODEL@
Environment=DORO_CONTROL_PLANE_OPENAI_DEFAULT_RESPONSE_MODEL=@DORO_CONTROL_PLANE_OPENAI_DEFAULT_RESPONSE_MODEL@
Environment=DORO_CONTROL_PLANE_OPENAI_TIMEOUT_SECONDS=@DORO_CONTROL_PLANE_OPENAI_TIMEOUT_SECONDS@
Environment=DORO_CONTROL_PLANE_AI_AGENT_MAX_TURNS=@DORO_CONTROL_PLANE_AI_AGENT_MAX_TURNS@
Environment=DORO_CONTROL_PLANE_AI_AGENT_MAX_TOOL_CALLS=@DORO_CONTROL_PLANE_AI_AGENT_MAX_TOOL_CALLS@
Environment=DORO_CONTROL_PLANE_AI_AGENT_TOOL_TIMEOUT_SECONDS=@DORO_CONTROL_PLANE_AI_AGENT_TOOL_TIMEOUT_SECONDS@
Environment=DORO_CONTROL_PLANE_AI_AGENT_SHELL_TIMEOUT_SECONDS=@DORO_CONTROL_PLANE_AI_AGENT_SHELL_TIMEOUT_SECONDS@
Environment=DORO_CONTROL_PLANE_AI_AGENT_APPROVAL_TIMEOUT_SECONDS=@DORO_CONTROL_PLANE_AI_AGENT_APPROVAL_TIMEOUT_SECONDS@
WorkingDirectory=@DORO_CONTROL_PLANE_STATE_DIR@
ExecStart=@DORO_BIN@ control-plane
Restart=always
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@DORO_CONTROL_PLANE_STATE_DIR@
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
